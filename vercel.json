{
  "outputDirectory": "www",
  "redirects": [
    {
      "source": "/((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "claro-app2.vercel.app"
        }
      ],
      "destination": "https://app.claro-app.ch/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src * 'unsafe-inline' 'unsafe-eval' data: blob:; script-src * 'unsafe-inline' 'unsafe-eval' blob:; worker-src 'self' blob:;"
        }
      ]
    }
  ],
  "functions": {
    "api/analyse.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/notify-deadlines",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/notify-inactive",
      "schedule": "0 10 * * *"
    }
  ]
}
